{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" },
          "category": { "type": "string" }
        },
        "required": ["question", "answer", "category"]
      }
    }
  },
  "required": ["faqs"]
}
