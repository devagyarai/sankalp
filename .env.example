# Sankalp Environment Configuration
# ---------------------------------------------------------
# PUBLIC VARIABLES (Frontend)
# These variables are safe to expose to the browser.
# ---------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=false

# ---------------------------------------------------------
# PRIVATE VARIABLES (Backend)
# These MUST NEVER be prefixed with NEXT_PUBLIC_.
# Do NOT commit real values to version control.
# ---------------------------------------------------------
APP_ENV=development

# Database Settings
POSTGRES_USER=sankalp_user
POSTGRES_PASSWORD=sankalp_password_placeholder
POSTGRES_DB=sankalp_db
DATABASE_URL=postgresql://sankalp_user:sankalp_password_placeholder@localhost:5432/sankalp_db

# Security & API Settings
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=development_secret_do_not_use_in_production
